# Continue API settings.
# The CLI does not load a .env from the working directory. Put these in the
# environment, or CONTINUE_API_BASE in ~/.continuous/.env. Secrets in that
# global file are still resolved by name.
# API base URL - defaults to https://api.continue.dev/ if not specified
CONTINUE_API_BASE=http://localhost:3001

# Continue API key
# This is required for authentication with the Continue API
CONTINUE_API_KEY=
